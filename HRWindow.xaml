<Window x:Class="ST10446806_PROG6212_POEPART1.Windows.HRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HRWindow" Height="450" Width="800">

    <Grid>
        <Label Content="Lecturers" FontWeight="Bold" Margin="10,10,0,0"/>
        <DataGrid Name="LecturerDataGrid" Margin="10,40,10,250" AutoGenerateColumns="True"/>
        <Button Content="Save Changes" Click="SaveLecturerChanges_Click" Margin="10,200,10,210" Height="30" Width="120"/>

        <Label Content="Approved Claims" FontWeight="Bold" Margin="10,300,0,0"/>
        <DataGrid Name="ClaimsDataGrid" Margin="10,330,10,50" AutoGenerateColumns="True"/>
        <Button Content="Generate Report" Click="GenerateReport_Click" Margin="150,300,0,0" Height="30" Width="150"/>

        <Button Content="Logout" Click="LogoutButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"/>
    </Grid>
</Window>
