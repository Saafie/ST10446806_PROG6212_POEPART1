<Window x:Class="ST10446806_PROG6212_POEPART1.HRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HR Window" Height="450" Width="800">
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Lecturer List -->
        <GroupBox Header="Lecturers" Grid.Column="0" Margin="5">
            <ListBox Name="LecturerListBox" DisplayMemberPath="FullName" SelectionChanged="LecturerListBox_SelectionChanged"/>
        </GroupBox>

        <!-- Lecturer Details -->
        <GroupBox Header="Lecturer Details" Grid.Column="1" Margin="5">
            <StackPanel Margin="10">
                <TextBlock Text="Full Name"/>
                <TextBox Name="FullNameTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Email"/>
                <TextBox Name="EmailTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Phone Number"/>
                <TextBox Name="PhoneTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Hourly Rate"/>
                <TextBox Name="HourlyRateTextBox" Margin="0,5,0,10"/>

                <TextBlock Text="Bank Details"/>
                <TextBox Name="BankDetailsTextBox" Margin="0,5,0,10"/>

                <Button Name="SaveButton" Content="Save" Width="100" Click="SaveButton_Click"/>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>
